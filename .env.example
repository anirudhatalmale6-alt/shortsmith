# Shortsmith configuration.
# Copy to .env and edit. Every setting below already has a working default, so a
# fresh clone renders a video with this file left empty.

# --- web ---------------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
# Must match the authorised redirect URI in Google Cloud Console, minus the path.
PUBLIC_BASE_URL=http://127.0.0.1:8080
# Change this before putting the app on a public address.
SECRET_KEY=change-me-in-production
# Leave empty for no login wall. Set it if the app is reachable from the internet.
APP_PASSWORD=

# --- script writing ----------------------------------------------------------
# ollama | openai | offline
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Any OpenAI-compatible endpoint: OpenAI, Groq, OpenRouter, LM Studio, vLLM.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- visuals -----------------------------------------------------------------
# hfspace | pollinations | sdwebui | comfyui | pexels | gradient
#   hfspace      - a public Hugging Face Space, FLUX.1-schnell by default.
#                  Best quality without your own GPU. Needs HF_TOKEN below:
#                  anonymous callers get almost no GPU time. The token is free,
#                  takes 30 seconds and needs no card.
#                  huggingface.co/join then huggingface.co/settings/tokens
#   pollinations - another free hosted generator, no key, but rate limited
#   sdwebui      - local AUTOMATIC1111 / Forge started with --api
#   comfyui      - local ComfyUI
#   pexels       - stock photography, free API key
#   gradient     - procedural plates, fully offline, never fails
IMAGE_PROVIDER=hfspace
# Free account token from huggingface.co/settings/tokens (read scope is enough).
HF_TOKEN=
# Override the Space if you prefer a different model.
HF_SPACE=black-forest-labs/FLUX.1-schnell
SDWEBUI_URL=http://127.0.0.1:7860
SDWEBUI_MODEL=
COMFYUI_URL=http://127.0.0.1:8188
PEXELS_API_KEY=
# Seconds to wait between calls to the free hosted generator.
POLLINATIONS_GAP=32

# --- voice -------------------------------------------------------------------
# piper (offline, free) | edge (Microsoft neural voices, free, needs network)
TTS_PROVIDER=piper
PIPER_VOICE=en_US-amy-medium
EDGE_VOICE=en-US-AriaNeural

# --- captions ----------------------------------------------------------------
# tiny.en | base.en | small.en | medium.en - bigger is more accurate and slower
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# --- video -------------------------------------------------------------------
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
FFMPEG=ffmpeg
FFPROBE=ffprobe
# 0 lets ffmpeg decide; set it if the box is shared.
RENDER_THREADS=0

# --- worker ------------------------------------------------------------------
# 1 runs the worker inside the web process; 0 to run `python -m shortsmith.worker`
WORKER_ENABLED=1
WORKER_POLL_SECONDS=15
MAX_CLIP_MINUTES=90

# --- youtube -----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- yt-dlp ------------------------------------------------------------------
# YouTube blocks most datacentre IPs with "Sign in to confirm you're not a bot".
# Export cookies.txt from a signed-in browser and point this at it, or use a proxy.
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_PROXY=

# --- storage -----------------------------------------------------------------
# DATABASE_URL=sqlite:///./data/shortsmith.db
# DATA_DIR=./data
